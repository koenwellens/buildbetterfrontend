---
import type { ResolvedExample } from '../../lib/content/examples.ts';
import SourceFile from './SourceFile.astro';
import ExamplePreview from './ExamplePreview.astro';
interface Props { examples: ResolvedExample[] }
const { examples } = Astro.props;
---

{examples.length > 0 && <section class="examples container container--example" aria-labelledby="examples-title">
  <div class="section-heading"><p class="technical-label">Build it. See it.</p><h2 id="examples-title">Explore the examples</h2></div>
  {examples.map((example, index) => <section class="example" data-example={example.id} id={`example-${example.id}`} aria-labelledby={`example-title-${example.id}`}>
    <header class="example-heading">
      <p class="technical-label">Example {String(index + 1).padStart(2, '0')}</p>
      <h3 id={`example-title-${example.id}`}>{example.title}</h3>
      {example.description && <p>{example.description}</p>}
      {example.repositoryUrl && <p><a href={example.repositoryUrl}>Source repository for {example.title} <span aria-hidden="true">↗</span></a></p>}
    </header>
    <ExamplePreview example={example} />
    {example.sourceFiles.length > 0 && <section class="sources" data-code={example.id} id={`code-${example.id}`} aria-label={`Source files for ${example.title}`}>
      {example.sourceFiles.map(source => <SourceFile source={source} exampleId={example.id} />)}
    </section>}
  </section>)}
</section>}

<style>
  .examples { margin-block: var(--space-64); }
  .section-heading { margin-block-end: var(--space-32); }
  .section-heading h2 { margin-block-start: var(--space-8); }
  .example { border-block-start: var(--border-width) solid var(--color-border); padding-block: var(--space-32); display: grid; gap: var(--space-24); min-inline-size: 0; }
  .example-heading { display: grid; gap: var(--space-12); max-inline-size: var(--width-reading); }
  .example-heading > p:not(.technical-label) { color: var(--color-text-secondary); }
  .sources { display: grid; gap: var(--space-24); min-inline-size: 0; }
</style>
